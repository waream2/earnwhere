---
import HeaderLink from './HeaderLink.astro';
import Logo from './Logo.astro';
import MassToggle from './MassToggle.astro';
import SpacetimeFabric from './SpacetimeFabric.astro';
import { SITE_TITLE } from '../consts';
---

<SpacetimeFabric />
<MassToggle />
<header class="site-header">
	<a href="/" class="brand" aria-label={SITE_TITLE}>
		<Logo size={32} />
		<span class="wordmark">{SITE_TITLE}</span>
	</a>
	<nav class="desktop-nav">
		<HeaderLink href="/">home</HeaderLink>
		<HeaderLink href="/work">work</HeaderLink>
		<HeaderLink href="/writing">writing</HeaderLink>
		<HeaderLink href="/about">about</HeaderLink>
	</nav>
	<details class="mobile-nav">
		<summary aria-label="Menu">menu</summary>
		<nav class="mobile-nav-panel">
			<HeaderLink href="/">home</HeaderLink>
			<HeaderLink href="/work">work</HeaderLink>
			<HeaderLink href="/writing">writing</HeaderLink>
			<HeaderLink href="/about">about</HeaderLink>
		</nav>
	</details>
</header>

<script>
	// Close mobile menu on outside click.
	document.addEventListener('click', (e) => {
		const details = document.querySelector<HTMLDetailsElement>('.mobile-nav');
		if (!details?.open) return;
		if (!details.contains(e.target as Node)) {
			details.open = false;
		}
	});
	// Close on Escape.
	document.addEventListener('keydown', (e) => {
		if (e.key !== 'Escape') return;
		const details = document.querySelector<HTMLDetailsElement>('.mobile-nav');
		if (details?.open) details.open = false;
	});
</script>

<style>
	.site-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: var(--space-6) var(--space-6);
		max-width: var(--max-content);
		margin: 0 auto;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		color: var(--ink);
	}

	.brand:hover { color: var(--ink); }

	.wordmark {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		letter-spacing: 0.04em;
		color: var(--ink);
		font-weight: 500;
	}

	.desktop-nav {
		display: flex;
		gap: var(--space-6);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--ink-2);
		letter-spacing: 0.04em;
	}

	.mobile-nav {
		display: none;
		position: relative;
	}

	.mobile-nav summary {
		list-style: none;
		cursor: pointer;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.04em;
		color: var(--ink-2);
		padding: var(--space-1) var(--space-2);
		margin: calc(var(--space-1) * -1) calc(var(--space-2) * -1);
		transition: color var(--duration) var(--ease-out);
	}

	.mobile-nav summary::-webkit-details-marker { display: none; }
	.mobile-nav summary::marker { content: ''; }

	.mobile-nav summary:hover,
	.mobile-nav[open] summary {
		color: var(--ink);
	}

	.mobile-nav-panel {
		position: absolute;
		top: calc(100% + var(--space-3));
		right: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: var(--space-4);
		padding: var(--space-5);
		min-width: 140px;
		background: rgba(7, 9, 13, 0.85);
		border: 1px solid var(--line);
		-webkit-backdrop-filter: blur(8px);
		backdrop-filter: blur(8px);
		animation: navFadeIn 0.22s var(--ease-out) both;
	}

	.mobile-nav-panel :global(a) {
		font-size: 0.95rem;
		letter-spacing: 0.03em;
		padding: var(--space-1) 0;
	}

	@keyframes navFadeIn {
		from {
			opacity: 0;
			transform: translateY(-4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 640px) {
		.site-header {
			padding: var(--space-5) var(--space-5);
		}
		.wordmark { display: none; }
		.desktop-nav { display: none; }
		.mobile-nav { display: block; }
	}
</style>
