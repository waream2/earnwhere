---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface ProjectLink {
	label: string;
	href: string;
}

interface Props {
	title: string;
	summary: string;
	image?: string;
	date: Date;
	category: 'professional' | 'personal' | 'craft';
	role?: string;
	stack?: string[];
	timeline?: string;
	status?: 'shipped' | 'archived' | 'in-progress';
	links?: ProjectLink[];
}

const { title, summary, image, category, stack, timeline, status, links } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={summary} />
	</head>

	<body>
		<Header />
		<main class="page-content">
			<article>
				<div class="eyebrow">
					<a class="category-link" href={`/work/${category}`}>{category}</a>
					{timeline && <><span class="sep" aria-hidden="true">·</span><span>{timeline}</span></>}
					{status && <><span class="sep" aria-hidden="true">·</span><span class="status-badge" data-status={status}>{status}</span></>}
				</div>

				<h1>{title}</h1>
				<p class="summary">{summary}</p>

				{image && (
					<figure class="hero">
						<img src={image} alt="" loading="eager" decoding="async" />
					</figure>
				)}

				<div class="meta-row">
					{stack && stack.length > 0 && (
						<ul class="stack" aria-label="stack">
							{stack.map((tech) => <li>{tech}</li>)}
						</ul>
					)}
					{links && links.length > 0 && (
						<div class="project-links">
							{links.map((link) => (
								<a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} &rarr;</a>
							))}
						</div>
					)}
				</div>

				<div class="prose">
					<slot />
				</div>

				<div class="back-row">
					<a href="/work" class="back-link">
						<span aria-hidden="true">&larr;</span> back to work
					</a>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	article {
		max-width: var(--max-content);
		margin: 0 auto;
		padding: var(--space-8) var(--space-6) var(--space-7);
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		font-family: var(--font-mono);
		font-size: var(--text-mono);
		color: var(--ink-3);
		letter-spacing: 0.04em;
		margin-bottom: var(--space-5);
		flex-wrap: wrap;
	}

	.eyebrow .sep {
		opacity: 0.6;
	}

	.category-link {
		color: var(--ink-2);
		text-decoration-line: underline;
		text-decoration-color: var(--link-underline);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.22em;
		transition: color var(--duration) var(--ease-out);
	}

	.category-link:hover {
		color: var(--accent);
		text-decoration-color: var(--accent);
	}

	h1 {
		font-family: var(--font-display);
		font-weight: 300;
		font-size: var(--text-display-lg);
		line-height: 1.05;
		letter-spacing: -0.03em;
		margin: 0 0 var(--space-4);
		color: var(--ink);
	}

	.summary {
		font-family: var(--font-body);
		font-style: italic;
		font-size: 1.125rem;
		line-height: 1.6;
		color: var(--ink-2);
		margin: 0 0 var(--space-7);
		max-width: 56ch;
	}

	.hero {
		margin: 0 0 var(--space-7);
		border: 1px solid var(--line);
		border-radius: 2px;
		overflow: hidden;
		background: rgba(232, 236, 230, 0.03);
	}

	.hero img {
		display: block;
		width: 100%;
		height: auto;
		object-fit: cover;
	}

	.meta-row {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: flex-start;
		gap: var(--space-5);
		margin-bottom: var(--space-7);
		padding-bottom: var(--space-5);
		border-bottom: 1px solid var(--line);
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.stack li {
		font-family: var(--font-mono);
		font-size: var(--text-mono);
		letter-spacing: 0.06em;
		text-transform: lowercase;
		color: var(--ink-2);
		padding: 3px 8px;
		border: 1px solid var(--line);
		border-radius: 2px;
	}

	.project-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
	}

	.project-links a {
		font-family: var(--font-mono);
		font-size: var(--text-mono);
		letter-spacing: 0.04em;
		color: var(--ink);
		text-decoration-line: underline;
		text-decoration-color: var(--link-underline);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.22em;
		transition: color var(--duration) var(--ease-out),
			text-decoration-color var(--duration) var(--ease-out);
	}

	.project-links a:hover {
		color: var(--accent);
		text-decoration-color: var(--accent);
	}

	.prose {
		max-width: var(--max-prose);
	}

	.prose:empty {
		display: none;
	}

	.back-row {
		margin-top: var(--space-8);
		padding-top: var(--space-6);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-mono);
		font-size: var(--text-mono);
		letter-spacing: 0.04em;
		color: var(--ink-3);
		text-decoration-line: underline;
		text-decoration-color: var(--link-underline);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.22em;
		transition: color var(--duration) var(--ease-out),
			text-decoration-color var(--duration) var(--ease-out);
	}

	.back-link:hover {
		color: var(--accent);
		text-decoration-color: var(--accent);
	}

	.back-link span {
		transition: transform var(--duration) var(--ease-out);
	}

	.back-link:hover span {
		transform: translateX(-3px);
	}

	@media (max-width: 640px) {
		article {
			padding: var(--space-6) var(--space-5) var(--space-7);
		}

		.summary {
			font-size: 1rem;
		}

		.meta-row {
			flex-direction: column;
			gap: var(--space-4);
		}
	}
</style>
