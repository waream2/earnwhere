---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const hrefNormalized = (href as string)?.replace(/\/$/, '') || '/';
const isActive =
	pathname === hrefNormalized ||
	(hrefNormalized !== '/' && pathname.startsWith(hrefNormalized));
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>

<style>
	a {
		position: relative;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--ink-2);
		text-decoration: none;
		letter-spacing: 0.04em;
		transition: color var(--duration) var(--ease-out);
	}

	a:hover,
	a.active {
		color: var(--ink);
	}

	/* Active-page marker: a small accent dash under the current section. */
	a.active::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -6px;
		height: 1px;
		background: var(--accent);
		animation: navMark var(--duration) var(--ease-out) both;
	}

	@keyframes navMark {
		from { transform: scaleX(0); opacity: 0; }
		to { transform: scaleX(1); opacity: 1; }
	}
</style>
