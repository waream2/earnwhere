---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import ProjectPage from '../../../layouts/ProjectPage.astro';
import ProjectGalleryPage from '../../../layouts/ProjectGalleryPage.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects', ({ data }) => !data.draft);
	return projects.map((project) => ({
		params: { slug: project.id },
		props: project,
	}));
}
type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { Content } = await render(project);
const isGallery = project.data.category !== 'professional';
---

{isGallery ? (
	<ProjectGalleryPage {...project.data}>
		<Content />
	</ProjectGalleryPage>
) : (
	<ProjectPage {...project.data}>
		<Content />
	</ProjectPage>
)}
