---
import type { CollectionEntry } from 'astro:content';

interface Props {
	projects: CollectionEntry<'projects'>[];
	emptyMessage?: string;
}

const { projects, emptyMessage = 'No projects yet — check back soon.' } = Astro.props;
---

<section class="feed projects">
	{projects.length === 0 ? (
		<p class="empty-state"><span class="em">{emptyMessage}</span></p>
	) : (
		projects.map((project) => (
			<article class="entry project-entry">
				<div class="date">
					<span class="category">{project.data.category}</span>
					{project.data.timeline && <><br />{project.data.timeline}</>}
				</div>
				<div>
					<h3>
						<a href={`/work/projects/${project.id}/`}>{project.data.title}</a>
					</h3>
					<p class="hook">{project.data.summary}</p>
					{project.data.status && (
						<p class="status-line">
							<span class="status-badge" data-status={project.data.status}>{project.data.status}</span>
						</p>
					)}
				</div>
			</article>
		))
	)}
</section>

<style>
	.projects {
		padding-bottom: var(--space-9);
	}

	.project-entry .date {
		line-height: 1.6;
	}

	.category {
		display: inline-block;
		color: var(--ink-2);
		text-transform: lowercase;
	}

	.status-line {
		margin: var(--space-3) 0 0;
	}

	.empty-state {
		text-align: center;
		color: var(--ink-3);
		padding: var(--space-8) var(--space-6);
		font-family: var(--font-body);
	}
</style>
