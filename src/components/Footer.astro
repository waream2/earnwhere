---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-inner">
		<span class="copyright">&copy; {year} Aaron Ware</span>
		<span class="sep" aria-hidden="true">&middot;</span>
		<a href="https://github.com/waream2" target="_blank" rel="noopener noreferrer">github</a>
		<span class="sep" aria-hidden="true">&middot;</span>
		<a
			class="x-link"
			href="https://x.com/earnwhere"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="X · @earnwhere"
		>
			<svg class="x-icon" viewBox="0 0 24 24" aria-hidden="true">
				<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
			</svg>
			<span>@earnwhere</span>
		</a>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: var(--space-9);
		padding: var(--space-6) var(--space-6) var(--space-7);
	}

	.footer-inner {
		max-width: var(--max-content);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-2);
		font-family: var(--font-mono);
		font-size: var(--text-mono);
		color: var(--ink-3);
		letter-spacing: 0.04em;
	}

	.sep {
		user-select: none;
	}

	a {
		color: var(--ink-3);
		text-decoration: none;
		transition: color var(--duration) var(--ease-out);
	}

	a:hover {
		color: var(--ink);
	}

	.x-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
	}

	.x-icon {
		width: 0.85em;
		height: 0.85em;
		fill: currentColor;
		display: block;
	}
</style>
