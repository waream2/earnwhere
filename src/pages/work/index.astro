---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ProjectList from '../../components/ProjectList.astro';
import WorkFilter from '../../components/WorkFilter.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';

const projects = (await getCollection('projects'))
	.filter((project) => !project.data.draft)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Work — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="page-content">
			<section class="work-header">
				<div class="eyebrow">work · field log</div>
				<h1>things i've <span class="em">built</span>.</h1>
				<p>problem, constraints, tradeoffs, and what i learned.</p>
			</section>

			<WorkFilter active="all" />
			<ProjectList projects={projects} />
		</main>
		<Footer />
	</body>
</html>

<style>
	.work-header {
		padding: var(--space-9) var(--space-6) var(--space-7);
		max-width: var(--max-content);
		margin: 0 auto;
	}

	.work-header .eyebrow {
		font-family: var(--font-mono);
		font-size: var(--text-mono);
		color: var(--ink-3);
		letter-spacing: 0.16em;
		margin-bottom: var(--space-6);
	}

	.work-header h1 {
		font-family: var(--font-display);
		font-weight: 300;
		font-size: var(--text-display-xl);
		line-height: 0.98;
		letter-spacing: -0.035em;
		margin: 0 0 var(--space-5);
		max-width: 14ch;
	}

	.work-header h1 .em {
		font-style: italic;
		font-weight: 300;
		color: var(--accent);
	}

	.work-header p {
		font-family: var(--font-body);
		font-style: italic;
		font-size: 1.125rem;
		color: var(--ink-2);
		margin: 0;
		max-width: 480px;
		line-height: 1.6;
	}

	@media (max-width: 640px) {
		.work-header {
			padding: var(--space-7) var(--space-5) var(--space-6);
		}
	}
</style>
