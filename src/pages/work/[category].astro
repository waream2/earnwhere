---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ProjectList from '../../components/ProjectList.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import WorkFilter from '../../components/WorkFilter.astro';
import { SITE_TITLE } from '../../consts';

type Category = 'professional' | 'personal' | 'craft';

const TAGLINES: Record<Category, string> = {
	professional: 'things i built in a professional context — for an employer or client.',
	personal: 'things i built for myself — side projects, experiments, and small bets.',
	craft: 'things i made off-screen — work that lives outside a code editor.',
};

export async function getStaticPaths() {
	return (['professional', 'personal', 'craft'] as const).map((category) => ({
		params: { category },
	}));
}

const { category } = Astro.params as { category: Category };

const projects = (await getCollection('projects'))
	.filter((p) => !p.data.draft && p.data.category === category)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const tagline = TAGLINES[category];
const useGallery = category !== 'professional';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Work · ${category} — ${SITE_TITLE}`} description={tagline} />
	</head>
	<body>
		<Header />
		<main class="page-content">
			<section class="work-header">
				<div class="eyebrow">work · {category}</div>
				<h1>{category}.</h1>
				<p>{tagline}</p>
			</section>

			<WorkFilter active={category} />
			{useGallery ? (
				<ProjectGallery
					projects={projects}
					emptyMessage={`Nothing under ${category} yet.`}
				/>
			) : (
				<ProjectList
					projects={projects}
					emptyMessage={`Nothing under ${category} yet.`}
				/>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	.work-header {
		padding: var(--space-9) var(--space-6) var(--space-7);
		max-width: var(--max-content);
		margin: 0 auto;
	}

	.work-header .eyebrow {
		font-family: var(--font-mono);
		font-size: var(--text-mono);
		color: var(--ink-3);
		letter-spacing: 0.16em;
		margin-bottom: var(--space-6);
		text-transform: lowercase;
	}

	.work-header h1 {
		font-family: var(--font-display);
		font-weight: 300;
		font-size: var(--text-display-xl);
		line-height: 0.98;
		letter-spacing: -0.035em;
		margin: 0 0 var(--space-5);
	}

	.work-header p {
		font-family: var(--font-body);
		font-style: italic;
		font-size: 1.125rem;
		color: var(--ink-2);
		margin: 0;
		max-width: 480px;
		line-height: 1.6;
	}

	@media (max-width: 640px) {
		.work-header {
			padding: var(--space-7) var(--space-5) var(--space-6);
		}
	}
</style>
