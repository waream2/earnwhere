---
import type { CollectionEntry } from 'astro:content';

interface Props {
	projects: CollectionEntry<'projects'>[];
	emptyMessage?: string;
}

const { projects, emptyMessage = 'Nothing here yet.' } = Astro.props;
---

<section class="gallery">
	{projects.length === 0 ? (
		<p class="empty-state"><span class="em">{emptyMessage}</span></p>
	) : (
		<div class="gallery-grid">
			{projects.map((project) => (
				<a class="card" href={`/work/projects/${project.id}/`}>
					<div class="card-media">
						{project.data.image ? (
							<img
								src={project.data.image}
								alt=""
								loading="lazy"
								decoding="async"
							/>
						) : (
							<div class="card-media-placeholder" aria-hidden="true">
								<span>{project.data.title.slice(0, 2).toLowerCase()}</span>
							</div>
						)}
					</div>
					<div class="card-body">
						<h3 class="card-title">{project.data.title}</h3>
						<p class="card-summary">{project.data.summary}</p>
						{project.data.stack && project.data.stack.length > 0 && (
							<ul class="card-stack" aria-label="stack">
								{project.data.stack.slice(0, 4).map((tech) => (
									<li>{tech}</li>
								))}
							</ul>
						)}
					</div>
				</a>
			))}
		</div>
	)}
</section>

<style>
	.gallery {
		max-width: var(--max-content);
		margin: 0 auto;
		padding: 0 var(--space-6) var(--space-9);
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-6);
	}

	.card {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: inherit;
		transition: transform var(--duration) var(--ease-out);
	}

	.card:hover {
		transform: translateY(-2px);
	}

	.card-media {
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background: rgba(232, 236, 230, 0.04);
		border: 1px solid var(--line);
		border-radius: 2px;
		margin-bottom: var(--space-4);
	}

	.card-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.4s var(--ease-out), filter var(--duration) var(--ease-out);
		filter: saturate(0.9);
	}

	.card:hover .card-media img {
		transform: scale(1.02);
		filter: saturate(1);
	}

	.card-media-placeholder {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-mono);
		font-size: 1.5rem;
		letter-spacing: 0.08em;
		color: var(--ink-3);
		background:
			linear-gradient(135deg, rgba(93, 255, 138, 0.04), transparent 60%),
			repeating-linear-gradient(
				45deg,
				rgba(232, 236, 230, 0.02) 0,
				rgba(232, 236, 230, 0.02) 1px,
				transparent 1px,
				transparent 8px
			);
	}

	.card-body {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.card-title {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 400;
		letter-spacing: -0.02em;
		line-height: 1.2;
		margin: 0;
		color: var(--ink);
		transition: color var(--duration) var(--ease-out);
	}

	.card:hover .card-title {
		color: var(--accent);
	}

	.card-summary {
		font-family: var(--font-body);
		font-size: 0.9375rem;
		font-style: italic;
		line-height: 1.55;
		color: var(--ink-2);
		margin: 0;
	}

	.card-stack {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		list-style: none;
		padding: 0;
		margin: var(--space-2) 0 0;
	}

	.card-stack li {
		font-family: var(--font-mono);
		font-size: var(--text-mono);
		letter-spacing: 0.06em;
		text-transform: lowercase;
		color: var(--ink-3);
		padding: 2px 6px;
		border: 1px solid var(--line);
		border-radius: 2px;
	}

	.empty-state {
		text-align: center;
		color: var(--ink-3);
		padding: var(--space-8) var(--space-6);
		font-family: var(--font-body);
	}

	@media (max-width: 720px) {
		.gallery {
			padding: 0 var(--space-5) var(--space-8);
		}

		.gallery-grid {
			grid-template-columns: 1fr;
			gap: var(--space-7);
		}
	}
</style>
