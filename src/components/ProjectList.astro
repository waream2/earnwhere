---
import type { CollectionEntry } from 'astro:content';

interface Props {
	projects: CollectionEntry<'projects'>[];
	emptyMessage?: string;
}

const { projects, emptyMessage = 'No projects yet — check back soon.' } = Astro.props;
---

<section class="projects">
	{projects.length === 0 ? (
		<p class="empty-state">{emptyMessage}</p>
	) : (
		projects.map((project) => (
			<article class="project-entry">
				<div class="project-meta">
					<span class="category" data-category={project.data.category}>{project.data.category}</span>
					{project.data.timeline && <span class="dot">·</span>}
					{project.data.timeline && <span>{project.data.timeline}</span>}
					{project.data.status && <span class="dot">·</span>}
					{project.data.status && <span class="status">{project.data.status}</span>}
				</div>
				<h2 class="project-title">
					<a href={`/work/projects/${project.id}/`}>{project.data.title}</a>
				</h2>
				<p class="project-summary">{project.data.summary}</p>
			</article>
		))
	)}
</section>

<style>
	.projects {
		max-width: var(--max-width);
		margin: 0 auto;
		padding: 0 var(--space-lg) var(--space-4xl);
	}

	.project-entry {
		padding: var(--space-xl) 0;
		border-bottom: 1px solid var(--border);
	}

	.project-entry:first-child {
		border-top: 1px solid var(--border);
	}

	.project-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-xs);
		margin-bottom: var(--space-xs);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--text-tertiary);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.category {
		color: var(--text-secondary);
	}

	.category[data-category='professional'] {
		color: var(--accent);
	}

	.dot {
		opacity: 0.5;
	}

	.status {
		color: var(--accent);
	}

	.project-title {
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 400;
		line-height: 1.25;
		margin: var(--space-xs) 0;
		letter-spacing: -0.01em;
	}

	.project-title a {
		color: var(--text);
		text-decoration: none;
		transition: color var(--duration) var(--ease-out);
	}

	.project-title a:hover {
		color: var(--accent);
	}

	.project-summary {
		color: var(--text-secondary);
		font-size: 0.95rem;
		line-height: 1.6;
		margin: var(--space-xs) 0 0;
	}

	.empty-state {
		text-align: center;
		color: var(--text-tertiary);
		padding: var(--space-2xl) var(--space-lg);
		font-style: italic;
	}

	@media (max-width: 640px) {
		.project-title {
			font-size: 1.3rem;
		}
	}
</style>
